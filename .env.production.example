# Variáveis de produção — copie para .env.production (ou configure no painel do
# provedor de deploy, ex.: Vercel → Project → Settings → Environment Variables).
#
# Sem estas variáveis o app roda em MODO LOCAL (dados no navegador / localStorage),
# útil para demonstração. Para multiusuário/produção, configure o Supabase.

# URL do projeto Supabase (ex.: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon) do Supabase
VITE_SUPABASE_ANON_KEY=

# IMPORTANTE (segurança):
# - NUNCA coloque a OPENAI_API_KEY aqui — ela é SECRET do backend (Edge Function),
#   nunca do frontend. O frontend só chama a Edge Function `ai-recipe-import`.
# - A service_role key do Supabase também NÃO vai no frontend.
